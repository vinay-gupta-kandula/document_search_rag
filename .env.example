DB_USER=rag_user
DB_PASSWORD=rag_password
DB_NAME=rag_metadata_db
DB_HOST=db
DB_PORT=5432

# Vector DB (Qdrant)
VECTOR_DB_HOST=vector_db
VECTOR_DB_PORT=6333
QDRANT_COLLECTION_NAME=document_chunks

# Embedding & Search
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Reranker Model
# Options: cross-encoder/ms-marco-MiniLM-L-6-v2 (local HuggingFace) or cohere API if COHERE_API_KEY is provided
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=

# LLM Provider Configuration
# Options: 'openai', 'mock' (or if OPENAI_API_KEY is empty/mock, falls back cleanly to built-in extractive/smart answering)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
